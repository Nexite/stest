# Usage: -DEXE=<path> [-DARGS=<arg>] [-DPATTERN=<regex>]; expects exit 70 and PATTERN in stderr.
if(NOT PATTERN)
  set(PATTERN "stest: unmodelled write32 0x40013800")
endif()
execute_process(COMMAND ${EXE} ${ARGS} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 70)
  message(FATAL_ERROR "expected exit 70, got '${rc}'; stderr: ${err}")
endif()
if(NOT err MATCHES "${PATTERN}")
  message(FATAL_ERROR "stderr missing '${PATTERN}'; got: ${err}")
endif()
