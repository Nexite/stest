# selftest_blinky_standalone: -DEXE=<blinky>
# Runs `blinky --run-ms 2100` and asserts: exit code 0, exactly 4 "EVT <t_ns> GPIO A5 <level>"
# lines, the i-th within +-1 ms of (i+1)*500 ms, levels 1,0,1,0 (first edge low->high).
execute_process(COMMAND ${EXE} --run-ms 2100
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "blinky exited with '${rc}'\nstdout:\n${out}\nstderr:\n${err}")
endif()
string(REGEX MATCHALL "EVT [0-9]+ GPIO A5 [01]" evts "${out}")
list(LENGTH evts n)
if(NOT n EQUAL 4)
  message(FATAL_ERROR "expected exactly 4 GPIO A5 events, got ${n}\nstdout:\n${out}\nstderr:\n${err}")
endif()
set(i 0)
foreach(e IN LISTS evts)
  string(REGEX REPLACE "EVT ([0-9]+) GPIO A5 ([01])" "\\1;\\2" parts "${e}")
  list(GET parts 0 t)
  list(GET parts 1 level)
  math(EXPR expect_t "(${i} + 1) * 500000000")
  math(EXPR expect_level "(${i} + 1) % 2")
  math(EXPR dt "${t} - ${expect_t}")
  if(dt LESS -1000000 OR dt GREATER 1000000)
    message(FATAL_ERROR "event ${i}: t=${t} ns, expected ${expect_t} +- 1 ms\n${out}")
  endif()
  if(NOT level EQUAL expect_level)
    message(FATAL_ERROR "event ${i}: level ${level}, expected ${expect_level}\n${out}")
  endif()
  math(EXPR i "${i} + 1")
endforeach()
message(STATUS "blinky events OK:\n${out}")
